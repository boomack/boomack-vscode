{
  "name": "boomack-vscode",
  "displayName": "Boomack",
  "description": "Boomack client for VS Code",
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Boomack",
      "type": "object",
      "properties": {
        "boomack.server.verbose": {
          "type": "boolean",
          "default": false,
          "description": "Run the Boomack Project Server with verbose output",
          "order": 1
        },
        "boomack.displayTitle": {
          "type": "string",
          "default": "filename",
          "enum": [
            "none",
            "filename",
            "filepath"
          ],
          "enumItemLabels": [
            "None",
            "Filename",
            "Path"
          ],
          "enumDescriptions": [
            null,
            "The name of the file",
            "The full path of the file"
          ],
          "description": "The title for display requests to Boomack",
          "order": 2
        }
      }
    },
    "commands": [
      {
        "command": "boomack.playground",
        "category": "Boomack",
        "title": "Playground"
      },
      {
        "command": "boomack.workspaceServer.reloadConfig",
        "category": "Boomack",
        "title": "Reload Project Server Configuration",
        "icon": "$(refresh)"
      },
      {
        "command": "boomack.workspaceServer.start",
        "category": "Boomack",
        "title": "Start Project Server",
        "icon": "$(run)"
      },
      {
        "command": "boomack.workspaceServer.stop",
        "category": "Boomack",
        "title": "Stop Project Server",
        "icon": "$(debug-stop)"
      },
      {
        "command": "boomack.server.add",
        "category": "Boomack",
        "title": "Add Server...",
        "icon": "$(add)"
      },
      {
        "command": "boomack.server.remove",
        "category": "Boomack",
        "title": "Remove Server",
        "shortTitle": "Remove",
        "icon": "$(close)"
      },
      {
        "command": "boomack.server.select",
        "category": "Boomack",
        "title": "Select Server"
      },
      {
        "command": "boomack.server.openInBrowser",
        "category": "Boomack",
        "title": "Open Server in Browser",
        "shortTitle": "Open",
        "icon": "$(link-external)"
      },
      {
        "command": "boomack.server.refresh",
        "category": "Boomack",
        "title": "Refresh Panel List",
        "shortTitle": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "boomack.server.refreshSelected",
        "category": "Boomack",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "boomack.panel.select",
        "category": "Boomack",
        "title": "Select Panel"
      },
      {
        "command": "boomack.panel.clear",
        "category": "Boomack",
        "title": "Clear Panel",
        "shortTitle": "Clear",
        "icon": "$(trash)"
      },
      {
        "command": "boomack.panel.openInBrowser",
        "category": "Boomack",
        "title": "Open Panel in Browser",
        "shortTitle": "Open",
        "icon": "$(link-external)"
      },
      {
        "command": "boomack.panel.refresh",
        "category": "Boomack",
        "title": "Refresh Slot List",
        "shortTitle": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "boomack.panel.refreshSelected",
        "category": "Boomack",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "boomack.slot.select",
        "category": "Boomack",
        "title": "Select Slot"
      },
      {
        "command": "boomack.slot.clear",
        "category": "Boomack",
        "title": "Clear Slot",
        "shortTitle": "Clear",
        "icon": "$(trash)"
      },
      {
        "command": "boomack.slot.zoomIn",
        "category": "Boomack",
        "title": "Slot Zoom In",
        "icon": "$(zoom-in)"
      },
      {
        "command": "boomack.slot.zoomOut",
        "category": "Boomack",
        "title": "Slot Zoom Out",
        "icon": "$(zoom-out)"
      },
      {
        "command": "boomack.slot.toggleMaximize",
        "category": "Boomack",
        "title": "Toggle Maximize Slot",
        "icon": "$(screen-full)"
      },
      {
        "command": "boomack.slot.openInBrowser",
        "category": "Boomack",
        "title": "Open Slot in Browser",
        "shortTitle": "Open",
        "icon": "$(link-external)"
      },
      {
        "command": "boomack.slot.remove",
        "category": "Boomack",
        "title": "Remove Slot",
        "icon": "$(remove)"
      },
      {
        "command": "boomack.display.activeDocument",
        "category": "Boomack",
        "title": "Display Active Document",
        "icon": "$(send)"
      },
      {
        "command": "boomack.display.activeDocument.source",
        "category": "Boomack",
        "title": "Display Text Source of Active Document",
        "icon": "$(code)"
      },
      {
        "command": "boomack.display.activeDocument.withMediaType",
        "category": "Boomack",
        "title": "Display Active Document with different Media Type...",
        "icon": "$(code-review)"
      },
      {
        "command": "boomack.display.activeDocument.inSlot.withId",
        "category": "Boomack",
        "title": "Display Active Document in Slot...",
        "icon": "$(send)"
      },
      {
        "command": "boomack.display.activeDocument.source.inSlot.withId",
        "category": "Boomack",
        "title": "Display Text Source in Slot...",
        "icon": "$(code)"
      },
      {
        "command": "boomack.display.activeDocument.withMediaType.inSlot.withId",
        "category": "Boomack",
        "title": "Display Active Document with different Media Type in Slot...",
        "icon": "$(code-review)"
      },
      {
        "command": "boomack.display.currentSelection.source",
        "category": "Boomack",
        "title": "Display Selection",
        "icon": "$(send)"
      },
      {
        "command": "boomack.display.currentSelection.withMediaType",
        "category": "Boomack",
        "title": "Display Selection with different Media Type",
        "icon": "$(code-review)"
      },
      {
        "command": "boomack.display.document",
        "category": "Boomack",
        "title": "Display on Boomack",
        "icon": "$(send)"
      },
      {
        "command": "boomack.display.document.source",
        "category": "Boomack",
        "title": "Display Text Source on Boomack",
        "icon": "$(code)"
      },
      {
        "command": "boomack.display.document.withMediaType",
        "category": "Boomack",
        "title": "Display on Boomack with Media Type...",
        "icon": "$(code-review)"
      },
      {
        "command": "boomack.display.selection.source",
        "category": "Boomack",
        "title": "Display Selection on Boomack",
        "icon": "$(send)"
      },
      {
        "command": "boomack.display.document.inPanel",
        "category": "Boomack",
        "title": "Display Document in default Slot",
        "icon": "$(send)"
      },
      {
        "command": "boomack.display.document.source.inPanel",
        "category": "Boomack",
        "title": "Display Text Source",
        "icon": "$(code)"
      },
      {
        "command": "boomack.display.document.inSlot",
        "category": "Boomack",
        "title": "Display Document",
        "icon": "$(send)"
      },
      {
        "command": "boomack.display.document.source.inSlot",
        "category": "Boomack",
        "title": "Display Text Source",
        "icon": "$(code)"
      },
      {
        "command": "boomack.display.file",
        "category": "Boomack",
        "title": "Display on Boomack",
        "icon": "$(send)"
      },
      {
        "command": "boomack.display.file.source",
        "category": "Boomack",
        "title": "Display Text Source on Boomack",
        "icon": "$(code)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "boomack",
          "title": "Boomack",
          "icon": "res/boomack-logo-black.svg"
        }
      ]
    },
    "views": {
      "boomack": [
        {
          "id": "boomack-servers",
          "name": "Servers",
          "icon": "$(server)"
        },
        {
          "id": "boomack-panels",
          "name": "Panels",
          "icon": "$(multiple-windows)"
        },
        {
          "id": "boomack-slots",
          "name": "Slots",
          "icon": "$(symbol-enum)"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        { "command": "boomack.server.add" },
        { "command": "boomack.server.remove" },
        {
          "command": "boomack.workspaceServer.reloadConfig",
          "when": "!boomack.workspaceServer.running"
        },
        {
          "command": "boomack.workspaceServer.start",
          "when": "!boomack.workspaceServer.running"
        },
        {
          "command": "boomack.workspaceServer.stop",
          "when": "boomack.workspaceServer.running"
        },
        { "command": "boomack.server.select" },
        { "command": "boomack.server.openInBrowser" },
        { "command": "boomack.server.refresh" },
        { "command": "boomack.server.refreshSelected", "when": "false" },
        { "command": "boomack.panel.select" },
        { "command": "boomack.panel.clear" },
        { "command": "boomack.panel.openInBrowser" },
        { "command": "boomack.panel.refresh" },
        { "command": "boomack.panel.refreshSelected", "when": "false" },
        { "command": "boomack.slot.select" },
        { "command": "boomack.slot.clear" },
        { "command": "boomack.slot.openInBrowser" },
        { "command": "boomack.slot.zoomIn" },
        { "command": "boomack.slot.zoomOut" },
        { "command": "boomack.slot.toggleMaximize" },
        {
          "command": "boomack.display.activeDocument",
          "when": "boomack.activeTextEditor && boomack.serverSelected"
        },
        {
          "command": "boomack.display.activeDocument.source",
          "when": "boomack.activeTextEditor && boomack.serverSelected"
        },
        {
          "command": "boomack.display.activeDocument.withMediaType",
          "when": "boomack.activeTextEditor && boomack.serverSelected"
        },
        {
          "command": "boomack.display.activeDocument.inSlot.withId",
          "when": "boomack.activeTextEditor && boomack.panelSelected"
        },
        {
          "command": "boomack.display.activeDocument.source.inSlot.withId",
          "when": "boomack.activeTextEditor && boomack.panelSelected"
        },
        {
          "command": "boomack.display.activeDocument.withMediaType.inSlot.withId",
          "when": "boomack.activeTextEditor && boomack.panelSelected"
        },
        {
          "command": "boomack.display.currentSelection.source",
          "when": "editorHasSelection && boomack.serverSelected"
        },
        {
          "command": "boomack.display.currentSelection.withMediaType",
          "when": "editorHasSelection && boomack.serverSelected"
        },
        { "command": "boomack.display.document", "when": "false" },
        { "command": "boomack.display.document.source", "when": "false" },
        { "command": "boomack.display.selection.source", "when": "false" },
        { "command": "boomack.display.document.inPanel", "when": "false" },
        { "command": "boomack.display.document.source.inPanel", "when": "false" },
        { "command": "boomack.display.document.inSlot", "when": "false" },
        { "command": "boomack.display.document.source.inSlot", "when": "false" },
        { "command": "boomack.display.file", "when": "false" },
        { "command": "boomack.display.file.source", "when": "false" }
      ],
      "view/title": [
        {
          "command": "boomack.server.add",
          "when": "view == boomack-servers",
          "group": "navigation"
        },
        {
          "command": "boomack.server.refreshSelected",
          "when": "view == boomack-panels && boomack.serverSelected",
          "group": "navigation"
        },
        {
          "command": "boomack.panel.refreshSelected",
          "when": "view == boomack-slots && boomack.panelSelected",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "boomack.workspaceServer.reloadConfig",
          "when": "view == boomack-servers && viewItem == workspaceServer && !boomack.workspaceServer.running",
          "group": "inline@1"
        },
        {
          "command": "boomack.server.refresh",
          "when": "view == boomack-servers && (viewItem != workspaceServer || boomack.workspaceServer.running)",
          "group": "inline@1"
        },
        {
          "command": "boomack.workspaceServer.start",
          "when": "view == boomack-servers && viewItem == workspaceServer && !boomack.workspaceServer.running",
          "group": "inline@2"
        },
        {
          "command": "boomack.workspaceServer.stop",
          "when": "view == boomack-servers && viewItem == workspaceServer && boomack.workspaceServer.running",
          "group": "inline@2"
        },
        {
          "command": "boomack.server.remove",
          "when": "view == boomack-servers && viewItem == inventoryServer",
          "group": "inline@2"
        },
        {
          "command": "boomack.server.openInBrowser",
          "when": "view == boomack-servers && (viewItem == inventoryServer || boomack.workspaceServer.running)",
          "group": "inline@3"
        },
        {
          "command": "boomack.display.document.inPanel",
          "alt": "boomack.display.document.source.inPanel",
          "when": "view == boomack-panels && boomack.activeTextEditor",
          "group": "inline@1"
        },
        {
          "command": "boomack.panel.refresh",
          "when": "view == boomack-panels",
          "group": "inline@2"
        },
        {
          "command": "boomack.panel.clear",
          "when": "view == boomack-panels",
          "group": "inline@3"
        },
        {
          "command": "boomack.panel.openInBrowser",
          "when": "view == boomack-panels",
          "group": "inline@4"
        },
        {
          "command": "boomack.slot.zoomIn",
          "when": "view == boomack-slots"
        },
        {
          "command": "boomack.slot.zoomOut",
          "when": "view == boomack-slots"
        },
        {
          "command": "boomack.slot.toggleMaximize",
          "when": "view == boomack-slots"
        },
        {
          "command": "boomack.display.document.inSlot",
          "alt": "boomack.display.document.source.inSlot",
          "when": "view == boomack-slots && boomack.activeTextEditor",
          "group": "inline@1"
        },
        {
          "command": "boomack.slot.clear",
          "when": "view == boomack-slots",
          "group": "inline@2"
        },
        {
          "command": "boomack.slot.openInBrowser",
          "when": "view == boomack-slots",
          "group": "inline@3"
        },
        {
          "command": "boomack.slot.remove",
          "when": "view == boomack-slots"
        }
      ],
      "editor/title/run": [
        {
          "command": "boomack.display.document",
          "alt": "boomack.display.document.source",
          "when": "boomack.serverSelected && boomack.activeTextEditor"
        }
      ],
      "editor/context": [
        {
          "command": "boomack.display.selection.source",
          "when": "boomack.serverSelected && editor.hasSelection",
          "group": "2_boomack@10"
        },
        {
          "command": "boomack.display.document",
          "when": "boomack.serverSelected",
          "group": "2_boomack@20"
        },
        {
          "command": "boomack.display.document.source",
          "when": "boomack.serverSelected",
          "group": "2_boomack@21"
        },
        {
          "command": "boomack.display.document.withMediaType",
          "when": "boomack.serverSelected",
          "group": "2_boomack@22"
        }
      ],
      "explorer/context": [
        {
          "command": "boomack.display.file",
          "alt": "boomack.display.file.source",
          "when": "boomack.serverSelected",
          "group": "3_compare"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "dependencies": {
    "boomack": "0.14.9",
    "boomack-js": "0.11.7",
    "lodash-es": "^4.17.21",
    "mime": "^3.0.0",
    "open": "^10.2.0",
    "wait-on": "^8.0.4",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.103.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.32.0"
  }
}
