{
  "name": "boomack-vscode",
  "displayName": "Boomack",
  "description": "Boomack client for VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Boomack",
      "type": "object",
      "properties": {
        "boomack.displayTitle": {
          "type": "string",
          "default": "filename",
          "enum": ["none", "filename", "filepath"],
          "enumItemLabels": ["None", "Filename", "Path"],
          "enumDescriptions": [null, "The name of the file", "The full path of the file"],
          "description": "The title for display requests to Boomack",
          "order": 4
        }
      }
    },
    "commands": [
      {
        "command": "boomack.playground",
        "category": "Boomack",
        "title": "Playground"
      },
      {
        "command": "boomack.workspaceServer.reloadConfig",
        "category": "Boomack",
        "title": "Reload Project Server Configuration",
        "icon": "$(refresh)"
      },
      {
        "command": "boomack.workspaceServer.start",
        "category": "Boomack",
        "title": "Start Project Server",
        "icon": "$(run)"
      },
      {
        "command": "boomack.workspaceServer.stop",
        "category": "Boomack",
        "title": "Stop Project Server",
        "icon": "$(debug-stop)"
      },
      {
        "command": "boomack.server.add",
        "category": "Boomack",
        "title": "Add Server...",
        "icon": "$(add)"
      },
      {
        "command": "boomack.server.remove",
        "category": "Boomack",
        "title": "Remove Server",
        "shortTitle": "Remove",
        "icon": "$(close)"
      },
      {
        "command": "boomack.server.select",
        "category": "Boomack",
        "title": "Select Server"
      },
      {
        "command": "boomack.server.openInBrowser",
        "category": "Boomack",
        "title": "Open Server in Browser",
        "shortTitle": "Open",
        "icon": "$(link-external)"
      },
      {
        "command": "boomack.server.refresh",
        "category": "Boomack",
        "title": "Refresh Panel List",
        "shortTitle": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "boomack.server.refreshSelected",
        "category": "Boomack",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "boomack.panel.select",
        "category": "Boomack",
        "title": "Select Panel"
      },
      {
        "command": "boomack.panel.clear",
        "category": "Boomack",
        "title": "Clear Panel",
        "shortTitle": "Clear",
        "icon": "$(trash)"
      },
      {
        "command": "boomack.panel.openInBrowser",
        "category": "Boomack",
        "title": "Open Panel in Browser",
        "shortTitle": "Open",
        "icon": "$(link-external)"
      },
      {
        "command": "boomack.panel.refresh",
        "category": "Boomack",
        "title": "Refresh Slot List",
        "shortTitle": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "boomack.panel.refreshSelected",
        "category": "Boomack",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "boomack.slot.select",
        "category": "Boomack",
        "title": "Select Slot"
      },
      {
        "command": "boomack.slot.clear",
        "category": "Boomack",
        "title": "Clear Slot",
        "shortTitle": "Clear",
        "icon": "$(trash)"
      },
      {
        "command": "boomack.slot.zoomIn",
        "category": "Boomack",
        "title": "Slot Zoom In",
        "icon": "$(zoom-in)"
      },
      {
        "command": "boomack.slot.zoomOut",
        "category": "Boomack",
        "title": "Slot Zoom Out",
        "icon": "$(zoom-out)"
      },
      {
        "command": "boomack.slot.toggleMaximize",
        "category": "Boomack",
        "title": "Toggle Maximize Slot",
        "icon": "$(screen-full)"
      },
      {
        "command": "boomack.slot.openInBrowser",
        "category": "Boomack",
        "title": "Open Slot in Browser",
        "shortTitle": "Open",
        "icon": "$(link-external)"
      },
      {
        "command": "boomack.display.inSlot",
        "category": "Boomack",
        "title": "Display file of active editor",
        "icon": "$(send)"
      },
      {
        "command": "boomack.display.document",
        "category": "Boomack",
        "title": "Display document in Boomack slot",
        "icon": "$(send)"
      },
      {
        "command": "boomack.display.fileResource",
        "category": "Boomack",
        "title": "Display on Boomack",
        "icon": "$(send)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "boomack",
          "title": "Boomack",
          "icon": "res/boomack-logo-black.svg"
        }
      ]
    },
    "views": {
      "boomack": [
        {
          "id": "boomack-servers",
          "name": "Servers",
          "icon": "$(server)"
        },
        {
          "id": "boomack-panels",
          "name": "Panels",
          "icon": "$(multiple-windows)"
        },
        {
          "id": "boomack-slots",
          "name": "Slots",
          "icon": "$(symbol-enum)"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        { "command": "boomack.server.add" },
        { "command": "boomack.server.remove" },
        { "command": "boomack.server.select" },
        {
          "command": "boomack.workspaceServer.reloadConfig",
          "when": "!boomack.workspaceServer.running"
        },
        {
          "command": "boomack.workspaceServer.start",
          "when": "!boomack.workspaceServer.running"
        },
        {
          "command": "boomack.workspaceServer.stop",
          "when": "boomack.workspaceServer.running"
        },
        { "command": "boomack.server.openInBrowser" },
        { "command": "boomack.server.refresh" },
        {
          "command": "boomack.server.refreshSelected",
          "when": "false"
        },
        { "command": "boomack.panel.select" },
        { "command": "boomack.panel.clear" },
        { "command": "boomack.panel.openInBrowser" },
        { "command": "boomack.panel.refresh" },
        {
          "command": "boomack.panel.refreshSelected",
          "when": "false"
        },
        { "command": "boomack.slot.select" },
        { "command": "boomack.slot.clear" },
        { "command": "boomack.slot.openInBrowser" },
        { "command": "boomack.slot.zoomIn" },
        { "command": "boomack.slot.zoomOut" },
        { "command": "boomack.slot.toggleMaximize" }
      ],
      "view/title": [
        {
          "command": "boomack.server.add",
          "when": "view == boomack-servers",
          "group": "navigation"
        },
        {
          "command": "boomack.server.refreshSelected",
          "when": "view == boomack-panels && boomack.serverSelected",
          "group": "navigation"
        },
        {
          "command": "boomack.panel.refreshSelected",
          "when": "view == boomack-slots && boomack.panelSelected",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "boomack.workspaceServer.reloadConfig",
          "when": "view == boomack-servers && viewItem == workspaceServer && !boomack.workspaceServer.running",
          "group": "inline@1"
        },
        {
          "command": "boomack.server.refresh",
          "when": "view == boomack-servers && (viewItem != workspaceServer || boomack.workspaceServer.running)",
          "group": "inline@1"
        },
        {
          "command": "boomack.workspaceServer.start",
          "when": "view == boomack-servers && viewItem == workspaceServer && !boomack.workspaceServer.running",
          "group": "inline@2"
        },
        {
          "command": "boomack.workspaceServer.stop",
          "when": "view == boomack-servers && viewItem == workspaceServer && boomack.workspaceServer.running",
          "group": "inline@2"
        },
        {
          "command": "boomack.server.remove",
          "when": "view == boomack-servers && viewItem == inventoryServer",
          "group": "inline@2"
        },
        {
          "command": "boomack.server.openInBrowser",
          "when": "view == boomack-servers && (viewItem == inventoryServer || boomack.workspaceServer.running)",
          "group": "inline@3"
        },
        {
          "command": "boomack.panel.refresh",
          "when": "view == boomack-panels",
          "group": "inline@1"
        },
        {
          "command": "boomack.panel.clear",
          "when": "view == boomack-panels",
          "group": "inline@2"
        },
        {
          "command": "boomack.panel.openInBrowser",
          "when": "view == boomack-panels",
          "group": "inline@3"
        },
        {
          "command": "boomack.display.inSlot",
          "when": "view == boomack-slots && boomack.activeTextEditor",
          "group": "inline@1"
        },
        {
          "command": "boomack.slot.zoomIn",
          "when": "view == boomack-slots"
        },
        {
          "command": "boomack.slot.zoomOut",
          "when": "view == boomack-slots"
        },
        {
          "command": "boomack.slot.toggleMaximize",
          "when": "view == boomack-slots"
        },
        {
          "command": "boomack.slot.clear",
          "when": "view == boomack-slots",
          "group": "inline@2"
        },
        {
          "command": "boomack.slot.openInBrowser",
          "when": "view == boomack-slots",
          "group": "inline@3"
        }
      ],
      "editor/title/run": [
        {
          "command": "boomack.display.document",
          "when": "boomack.serverSelected && boomack.activeTextEditor"
        }
      ],
      "explorer/context": [
        {
          "command": "boomack.display.fileResource",
          "when": "boomack.serverSelected",
          "group": "3_compare"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "dependencies": {
    "boomack": "0.14.9",
    "boomack-js": "0.11.3",
    "lodash": "^4.17.21",
    "mime": "^3.0.0",
    "open": "^10.2.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.103.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "eslint": "^9.32.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
